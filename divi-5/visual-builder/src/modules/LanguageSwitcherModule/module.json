{
  "name": "lsad/language-sitcher-module-for-divi",
  "d4Shortcode": "language_switcher_module",
  "title": "Language Switcher Module",
  "titles": "Language Switcher Modules",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}"
    },
    "show_language_switcher": {
      "type": "object",
      "default": {
          "innerContent": {
            "desktop": {
              "value": "on"
            }
          }
        }
    },
    "switcher_layouts": {
      "type": "object",
      "default": {
          "innerContent": {
            "desktop": {
              "value": "vertical"
            }
          }
        }
    },
    "show_language_flag": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      }
    },
    "show_language_name": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      }
    },
    "show_language_code": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "hide_current_language": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "hide_untranslated_languages": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "aspect_ratio": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "auto"
          }
        }
      }
    },
    "flag_width": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "20" 
          }
        }
      }
    },
    "flag_border_radius": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "0"   
          }
        }
      }
    },
    "text_style": {
      "type": "object",
      "selector": "{{selector}} .lsad-wrapper ul li.lsad_active_lang.lsad_active_lang div:not(.lsad-lang-image), {{selector}} .lsad-wrapper ul li.lsad_active_lang div:not(.lsad-lang-image) a, {{selector}} .lsad-wrapper ul li:hover.lsad_active_lang div:not(.lsad-lang-image), {{selector}} .lsad-wrapper ul li:hover div:not(.lsad-lang-image) a, {{selector}} .lsad-wrapper ul li div:not(.lsad-lang-image) a"
    },
    "background_style": {
      "type": "object",
      "selector": "{{selector}} .lsad-wrapper ul li"
    },
    "sizing": {
      "type": "object",
      "selector": "{{selector}} .lsad-lang-name a"
    },
    "filters": {
      "type": "object",
      "selector": "{{selector}} .lsad-lang-name a"
    }
  }
}