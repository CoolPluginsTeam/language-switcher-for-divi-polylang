{
  "name": "cpfd/connect-polylang-for-divi",
  "d4Shortcode": "connect-polylang-for-divi",
  "title": "Language Switcher",
  "titles": "Language Switchers",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}"
    },
    "switcher_layouts": {
      "type": "object",
      "default": {
          "innerContent": {
            "desktop": {
              "value": "horizontal"
            }
          }
        }
    },
    "show_language_flag": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      }
    },
    "show_language_name": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      }
    },
    "show_language_code": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "hide_current_language": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "hide_untranslated_language": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "flag_style": {
      "type": "object",
      "default": {
        "innerContent": {
          "decoration": {
            "aspect_ratio": {
              "desktop": {
                "value": "auto" 
              }
            },
            "flag_width": {
              "desktop": {
                "value": "20" 
              }
            },
            "flag_border_radius": {
              "desktop": {
                "value": "0" 
              }
            }
          }
        }
      }
    },
    "text_style": {
      "type": "object",
      "selector": "{{selector}} .cpfd-wrapper ul li.cpfd_active_lang.cpfd_active_lang div:not(.cpfd-lang-image), {{selector}} .cpfd-wrapper ul li.cpfd_active_lang div:not(.cpfd-lang-image) a, {{selector}} .cpfd-wrapper ul li:hover.cpfd_active_lang div:not(.cpfd-lang-image), {{selector}} .cpfd-wrapper ul li:hover div:not(.cpfd-lang-image) a, {{selector}} .cpfd-wrapper ul li div:not(.cpfd-lang-image) a, {{selector}} .cpfd-wrapper.dropdown span div:not(.cpfd-lang-image) a"
    },
    "background_style": {
      "type": "object",
      "selector": "{{selector}} .cpfd-wrapper ul li, {{selector}} .cpfd-wrapper.dropdown"
    },
    "container_size": {
      "type": "object",
      "selector": "{{selector}} .cpfd-wrapper, {{selector}} .cpfd-wrapper.dropdown"
    },
    "color_filters": {
      "type": "object",
      "selector": "{{selector}} .cpfd-wrapper ul li, {{selector}} .cpfd-wrapper.dropdown span"
    }
  }
}